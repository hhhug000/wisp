wisp cartridge
version 1
__code__
local rx, ry = 54, 54
local speed = 1
local msg = 'PRESS Z OR X'

function _init()
    music(0)
end

function _update()
    if btn(0) then rx = rx - speed end
    if btn(1) then rx = rx + speed end
    if btn(2) then ry = ry - speed end
    if btn(3) then ry = ry + speed end

    if btnp(4) then
        sfx(0)
        msg = 'Z IS PRESSED!'
    elseif btnp(5) then
        sfx(1)
        msg = 'X IS PRESSED!'
    elseif not btn(4) and not btn(5) then
        msg = 'PRESS Z OR X'
    end
end

function _draw()
    cls(1)

    line(2, 2, 125, 2, 6)
    line(125, 2, 125, 125, 6)
    line(125, 125, 2, 125, 6)
    line(2, 125, 2, 2, 6)

    rect(10, 20, 30, 15, 8)
    
    spr(0, rx, ry)

    circ(96, 30, 10, 10)
    circfill(96, 30, 5, 11)

    pset(6, 6, 7)
    pset(7, 6, 7)
    pset(6, 7, 7)

    print('WISP DEMO', 36, 5, 7)
    print(msg, 20, 112, 10)

    local mx = mousex()
    local my = mousey()

    if mx ~= nil and my ~= nil then
        pset(mx, my, 8)
        pset(mx + 1, my, 8)
        pset(mx - 1, my, 8)
-- ch0, ch1, ch2, ch3, ticks
        pset(mx, my + 1, 8)
        pset(mx, my - 1, 8)
    else
        print('MOUSE OFF', 20, 100, 5)
    end
end
